VERSION="3.3.2"

show_usage(){
    cat << EOF
Usage: x509-tool <command> [args...]

  Commands:
    ca init <ca-name>             Initializes basic ca directory structure

    ica init <cname> <ou>         Add a new intermediate certificate authority and copy current config

    verify <cert-file>            Verifies a certificate against CRL
    show <cert-file>              Display a certificate as text

    client add <cname>            Add a new client certificate
    client revoke <cname>         Revoke a client certificate
    
    server add <cname> [san...]   Add a new server certificate (optional subject alt names)
    server revoke <cname>         Revoke a server vertificate
    
    host add <cname> [san...]     Add a new host certificate (optional subject alt names)
    host revoke <cname>           Revoke a host vertificate

    code add <cname>              Add a new codesigning certificate
    code revoke <cname>           Revoke a codesigning certificate

    smime add <cname> <email>     Add a new s/mime signing certificate
    smime revoke <email>          Revoke a s/mime signing certificate

    openvpn init <ca-name>        Initializes CA + tls auth, dhparams and single server

    util genpkey <output-file>    Generate a private key manually (uses cert.conf settings)

    --help                        Displays this help
    --version                     Displays version
EOF
    exit 0
}

show_version(){
    cat << EOF
x509-tool
 - Version: ${VERSION}
 - License: MPL-2.0 http://mozilla.org/MPL/2.0/
 - Repository: https://github.com/AenonDynamics/x509-tool
EOF
    exit 0
}

# simple processing
[ "${1:-}" = "--help" ] && show_usage
[ "${1:-}" = "--version" ] && show_version

# Strict mode: exit on error, undefined variables, and pipeline failures
set -euo pipefail

# Restrictive umask: private keys and config files must not be world-readable
umask 077

# current working dir
WORKING_DIR="$(pwd)"

# basedir
BASEDIR="$( cd "$( dirname "$(realpath "${BASH_SOURCE[0]}")" )" && pwd )"

# locations (overridable via environment for testing/development)
OVPN_BIN="${OVPN_BIN:-/usr/sbin/openvpn}"
OPENSSL_BIN="${OPENSSL_BIN:-/usr/bin/openssl}"
CONF_DIR="${CONF_DIR:-/etc/x509-tool}"
LIB_DIR="${LIB_DIR:-/usr/share/x509-tool}"

# command provided ?
if [ -z "${1:-}" ]; then
    show_usage
fi

# load bash functions
source "${LIB_DIR}/bash-functions"

# load command extensions
for x509ext in "${LIB_DIR}"/*.sh; do source "${x509ext}"; done

# VARS
# ----------------------------------------------

# directory structure
CA_DIRNAME="ca"
ICA_DIRNAME="ica"
SERVER_DIRNAME="server"
CLIENT_DIRNAME="client"
HOST_DIRNAME="host"
CSIGN_DIRNAME="codesign"
SMIME_DIRNAME="smime"

# Export Config Dirs
export CA_DIR="${WORKING_DIR}/${CA_DIRNAME}"
export ICA_DIR="${WORKING_DIR}/${ICA_DIRNAME}"
export SERVER_DIR="${WORKING_DIR}/${SERVER_DIRNAME}"
export CLIENT_DIR="${WORKING_DIR}/${CLIENT_DIRNAME}"
export HOST_DIR="${WORKING_DIR}/${HOST_DIRNAME}"
export CSIGN_DIR="${WORKING_DIR}/${CSIGN_DIRNAME}"
export SMIME_DIR="${WORKING_DIR}/${SMIME_DIRNAME}"

# default: empty SAN list (overwritten by resolveCertParams for server/host certs)
export KEY_SAN=""

# Warn about insecure passphrase handling (pass: exposes password in process list)
# ----------------------------------------------
function warn_insecure_passphrase(){
    local var_name var_value
    for var_name in CA_PASS_TYPE PKEY_PASS_TYPE P12_PASS_TYPE; do
        var_value="${!var_name}"
        if [ -n "${var_value}" ] && [[ "${var_value}" == pass:* ]]; then
            log_warning "SECURITY: ${var_name} uses 'pass:' — the password is visible in the process list (ps, /proc/*/cmdline)"
            log_warning "  Consider using 'env:VAR' or 'file:/path' instead. See: https://docs.openssl.org/3.6/man1/openssl-passphrase-options.html"
        fi
    done
}

# Check environment
# ----------------------------------------------
function environment_check(){

    # cert config available ?
    if [ ! -f "${WORKING_DIR}/cert.conf" ]; then
        log_error "Error: Configuration file cert.conf not found in current directory! Do you have created it yet?"
        log_error "An example file is available in ${CONF_DIR}/cert.example.conf"
        exit 1
    fi

    # warn if cert.conf is readable by group/others (contains passwords)
    local conf_perms
    conf_perms=$(stat -c "%a" "${WORKING_DIR}/cert.conf" 2>/dev/null || stat -f "%Lp" "${WORKING_DIR}/cert.conf" 2>/dev/null || true)
    if [ -n "${conf_perms}" ] && [ $((8#${conf_perms} & 8#077)) -ne 0 ]; then
        log_warning "SECURITY: cert.conf is readable by group/others (mode ${conf_perms}) — contains passwords!"
        log_warning "  Consider: chmod 600 ${WORKING_DIR}/cert.conf"
    fi

    # Load cert config/parameter
    source "${WORKING_DIR}/cert.conf"

    # warn about insecure passphrase options (pass: exposes password in process list)
    warn_insecure_passphrase

    # ca exists ?
    if [ "${1:-}" != "noca" ]; then
        [ -f "${CA_DIR}/ca.crt" ] || panic "certificate authority doesn't exist"
    fi
}

# Generate CommonName based on type/template
# ----------------------------------------------
function resolveCertParams(){

    # export common name as env
    case "${1}" in
        client_cert)
            export KEY_CN=$(printf "${CLIENT_COMMON_NAME}" "${2}")
            CRT_FILENAME="client"
            CRT_STORAGE_DIR="${CLIENT_DIR}"
        ;;

        server_cert)
            export KEY_CN=$(printf "${SRV_COMMON_NAME}" "${2}")
            CRT_FILENAME="server"
            CRT_STORAGE_DIR="${SERVER_DIR}"
            # build subjectAltName list: CN + additional domains
            export KEY_SAN="DNS:${KEY_CN}"
            shift 2
            for san in "$@"; do
                KEY_SAN="${KEY_SAN},DNS:${san}"
            done
            export KEY_SAN
        ;;

        host_cert)
            export KEY_CN=$(printf "${HOST_COMMON_NAME}" "${2}")
            CRT_FILENAME="host"
            CRT_STORAGE_DIR="${HOST_DIR}"
            # build subjectAltName list: CN + additional domains
            export KEY_SAN="DNS:${KEY_CN}"
            shift 2
            for san in "$@"; do
                KEY_SAN="${KEY_SAN},DNS:${san}"
            done
            export KEY_SAN
        ;;

        codesigning_cert)
            export KEY_CN=$(printf "${CODESIGNING_COMMON_NAME}" "${2}")
            CRT_FILENAME="code"
            CRT_STORAGE_DIR="${CSIGN_DIR}"
        ;;

        smime_cert)
            export KEY_EMAIL=$(printf "${SMIME_EMAIL_NAME}" "${3}")
            export KEY_CN=$(printf "${SMIME_COMMON_NAME}" "${2}")
            CRT_FILENAME="smime"
            CRT_STORAGE_DIR="${SMIME_DIR}"
        ;;

        ica_cert)
            export KEY_OU="${3}"
            export KEY_CN=$(printf "${ICA_COMMON_NAME}" "${2}")
            CRT_FILENAME="ca"
            CRT_STORAGE_DIR="${ICA_DIR}"
        ;;

        *)
            # unknown
            panic "error: unknown openssl extension <${1}>"
        ;;
    esac

    # cert naming scheme
    if [ "${CRT_SCHEME}" == "cn" ]; then
        CRT_FILENAME="${KEY_CN}"
    fi

    # derived crt output path
    CRT_OUTPUT_NAME="${CRT_STORAGE_DIR}/${KEY_CN}/${CRT_FILENAME}"
}

# generate new private key
# ----------------------------------------------
function cert_genpkey(){
    print_heading "generating new private ${KEY_TYPE} key"

    # build passphrase options (empty array = unencrypted key)
    local PASS_OPTS=()
    if [ -n "${2}" ]; then
        PASS_OPTS=(-pass "${2}" -aes-256-cbc)
    fi

    # generate EC key ?
    if [ "${KEY_TYPE}" == "EC" ]; then
        ${OPENSSL_BIN} genpkey \
            -algorithm EC \
            "${PASS_OPTS[@]}" \
            -pkeyopt "ec_paramgen_curve:${KEY_EC_CURVE}" \
            -pkeyopt ec_param_enc:named_curve \
            -out "${1}" || panic "error: cannot create private key"

    # default: RSA
    else
        ${OPENSSL_BIN} genpkey \
            -algorithm RSA \
            "${PASS_OPTS[@]}" \
            -pkeyopt "rsa_keygen_bits:${KEY_SIZE}" \
            -out "${1}" || panic "error: cannot create private key"
    fi
}

# Display Cert in clear-text
# ----------------------------------------------
function cert_show(){
    print_heading "Certificate [${1}]"
    ${OPENSSL_BIN} x509 \
        -in "${1}" \
        -text \
        -noout
}

# (Re-)Create the Certificate revocation list
# ----------------------------------------------
function crl_create(){
    print_heading "Certificate revocation list [${1:-${CA_DIR}}]"

    # generate crl
    ${OPENSSL_BIN} ca \
        -batch \
        -config "${CONF_DIR}/openssl.conf" \
        -passin "${CA_PASS_TYPE}" \
        -gencrl \
        -out "${CA_DIR}/crl.pem"

    # show crl
    ${OPENSSL_BIN} crl \
        -in "${CA_DIR}/crl.pem" \
        -noout \
        -text

    # join ca+crl for verification
    cat "${CA_DIR}/crl.pem" "${CA_DIR}/ca.crt" > "${CA_DIR}/ca-crl-verify.pem"
}

# Verifying Cert including Certificate revocation list
# ----------------------------------------------
function cert_verify(){
    print_heading "Verifying Certificate [${1}]"
    ${OPENSSL_BIN} verify \
        -crl_check \
        -x509_strict \
        -CAfile "${CA_DIR}/ca-crl-verify.pem" \
        "${1}"
}

# Validate common name for safe filesystem usage and RFC 5280 compliance
# ----------------------------------------------
function validate_cn(){
    local cn="${1}"

    # must not be empty
    [ -z "${cn}" ] && panic "error: common name (KEY_CN) is empty - refusing to proceed"

    # must not exceed 64 characters (RFC 5280 ub-common-name limit)
    if [ ${#cn} -gt 64 ]; then
        panic "error: common name exceeds 64 characters (RFC 5280 limit)"
    fi

    # must not contain path traversal or separator characters
    case "${cn}" in
        */*|*\\*|*..*|*$'\n'*|*$'\t'*)
            panic "error: common name contains invalid characters (path traversal or whitespace): [${cn}]"
        ;;
    esac

    # must not start with a dot or dash (prevents hidden files / option injection)
    case "${cn}" in
        .*|-*)
            panic "error: common name must not start with '.' or '-': [${cn}]"
        ;;
    esac
}

# Create new Cert
# ----------------------------------------------
function cert_create(){

    # safety: validate common name before using it as a path component
    validate_cn "${KEY_CN}"

    # cert already exists ?
    if [ -s "${CRT_OUTPUT_NAME}.crt" ]; then
        CRT_DIR="${CRT_STORAGE_DIR}/${KEY_CN}"
        log_warning "cert [${KEY_CN}] already exists in [${CRT_DIR}]"
        read -p "Do you want to create a new certificate and replace the old one? [y/N] " REPLY
        case "${REPLY}" in
            y|Y|yes|YES|Yes)
                # safety: never rm -rf with empty path components
                if [ -z "${CRT_STORAGE_DIR}" ] || [ -z "${KEY_CN}" ]; then
                    panic "error: refusing to delete - CRT_STORAGE_DIR or KEY_CN is empty"
                fi
                # safety: ensure CRT_DIR is inside CRT_STORAGE_DIR (prevent path traversal)
                case "${CRT_DIR}" in
                    "${CRT_STORAGE_DIR}"/*) : ;;
                    *) panic "error: refusing to delete - path [${CRT_DIR}] is outside [${CRT_STORAGE_DIR}]" ;;
                esac
                # revoke old cert before replacing it
                cert_revoke "${KEY_CN}"
                log_info "removing old cert directory [${CRT_DIR}]"
                rm -rf -- "${CRT_DIR}"
            ;;
            *)
                log_info "aborted - keeping existing cert [${KEY_CN}]"
                exit 0
            ;;
        esac
    fi

    print_heading "creating certificate for [${KEY_CN}]"
   
    # openssl extension
    OPENSSL_EXT="${1}"

    # create output dir
    mkdir -p "${CRT_STORAGE_DIR}/${KEY_CN}"

    # Show info
    log_info "${KEY_COUNTRY:-}"
    log_info "${KEY_PROVINCE:-}"
    log_info "${KEY_CITY:-}"
    log_info "${KEY_ORG:-}"
    log_info "${KEY_OU:-}"
    log_info "${KEY_CN:-}"
    log_info "${KEY_EMAIL:-}"

    # generate private key
    # ICA keys are CA keys — use CA_PASS_TYPE so openssl ca can read them later
    local CERT_KEY_PASS
    if [ "${OPENSSL_EXT}" == "ica_cert" ]; then
        CERT_KEY_PASS="${CA_PASS_TYPE}"
    else
        CERT_KEY_PASS="${PKEY_PASS_TYPE}"
    fi
    cert_genpkey "${CRT_OUTPUT_NAME}.key" "${CERT_KEY_PASS}"

    # create CSR
    log_info "generating signing request.."
    ${OPENSSL_BIN} req \
        -config "${CONF_DIR}/openssl.conf" \
        -new \
        -key "${CRT_OUTPUT_NAME}.key" \
        -passin "${CERT_KEY_PASS}" \
        -out "${CRT_OUTPUT_NAME}.csr" || panic "error: cannot create private key + csr"

    # Sign CSR -> Generate CERT
    log_info "creating cert.."
    ${OPENSSL_BIN} ca \
        -batch \
        -notext \
        -config "${CONF_DIR}/openssl.conf" \
        -days "${CRT_EXPIRE}" \
        -extensions "${OPENSSL_EXT}" \
        -passin "${CA_PASS_TYPE}" \
        -in "${CRT_OUTPUT_NAME}.csr" \
        -out "${CRT_OUTPUT_NAME}.crt" || panic "error: cannot sign cert"

    # Convert to p12 (easier handling)
    log_info "converting cert to p12 format.."
    ${OPENSSL_BIN} pkcs12 \
        -export \
        -in "${CRT_OUTPUT_NAME}.crt" \
        -inkey "${CRT_OUTPUT_NAME}.key" \
        -certfile "${CA_DIR}/ca-fullchain.pem" \
        -certpbe AES-256-CBC \
        -keypbe AES-256-CBC \
        -macalg sha256 \
        -out "${CRT_OUTPUT_NAME}.p12" \
        -passin "${CERT_KEY_PASS}" \
        -passout "${P12_PASS_TYPE}"

    # show cert
    cert_show "${CRT_OUTPUT_NAME}.crt"
}

# Revoke existing CRT
# ----------------------------------------------
function cert_revoke(){

    # cert must exist
    [ ! -f "${CRT_OUTPUT_NAME}.crt" ] && panic "cert [${KEY_CN}] does not exist!"

    print_heading "revoking cert [${1}].."
    ${OPENSSL_BIN} ca \
        -config "${CONF_DIR}/openssl.conf" \
        -passin "${CA_PASS_TYPE}" \
        -revoke "${CRT_OUTPUT_NAME}.crt" || panic "error: unable to revoke cert"

    # Re-Create CRL
    crl_create
}


# Command Dispatching
# ---------------------------------------
case "${1:-}:${2:-}" in
    ca:init)
        environment_check "noca"
        ca_init "${3:-}"
        exit 0
    ;;

    ica:init)
        environment_check "noca"
        ica_init "${3:-}" "${4:-}"
        exit 0
    ;;

    openvpn:init)
        environment_check "noca"
        openvpn_init "${3:-}"
        exit 0
    ;;

    client:add)
        environment_check
        resolveCertParams "client_cert" "${3:-}"
        cert_create "client_cert"
        exit 0
    ;;

    client:revoke)
        environment_check
        resolveCertParams "client_cert" "${3:-}"
        cert_revoke "${3:-}"
        exit 0
    ;;

    server:add)
        environment_check
        resolveCertParams "server_cert" "${3:-}" "${@:4}"
        cert_create "server_cert"
        exit 0
    ;;

    server:revoke)
        environment_check
        resolveCertParams "server_cert" "${3:-}"
        cert_revoke "${3:-}"
        exit 0
    ;;

    host:add)
        environment_check
        resolveCertParams "host_cert" "${3:-}" "${@:4}"
        cert_create "host_cert"
        exit 0
    ;;

    host:revoke)
        environment_check
        resolveCertParams "host_cert" "${3:-}"
        cert_revoke "${3:-}"
        exit 0
    ;;

    code:add)
        environment_check
        resolveCertParams "codesigning_cert" "${3:-}"
        cert_create "codesigning_cert"
        exit 0
    ;;

    code:revoke)
        environment_check
        resolveCertParams "codesigning_cert" "${3:-}"
        cert_revoke "${3:-}"
        exit 0
    ;;

    smime:add)
        environment_check
        resolveCertParams "smime_cert" "${3:-}" "${4:-}"
        cert_create "smime_cert"
        exit 0
    ;;

    smime:revoke)
        environment_check
        resolveCertParams "smime_cert" "${3:-}"
        cert_revoke "${3:-}"
        exit 0
    ;;

    show:*)
        cert_show "${2:-}"
        exit 0
    ;;

    verify:*)
        environment_check
        cert_verify "${2:-}"
        exit 0
    ;;

    util:genpkey)
        environment_check "noca"
        [ -z "${3:-}" ] && panic "error: output file required. Usage: x509-tool util genpkey <output-file>"
        cert_genpkey "${3:-}" "${PKEY_PASS_TYPE}"
        exit 0
    ;;

    *)
        show_usage
        exit 1
    ;;
esac
